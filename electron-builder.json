{
  "appId": "jp.yourorg.ndi-multisite",
  "productName": "NDI Multisite",
  "copyright": "Copyright © 2026",
  "directories": { "output": "release" },
  "files": [
    "dist/**/*",
    "assets/**/*",
    "node_modules/**/*",
    "package.json"
  ],
  "extraResources": [
    { "from": "assets", "to": "assets" }
  ],
  "win": {
    "target": [{ "target": "nsis", "arch": ["x64"] }],
    "icon": "assets/icon.png",
    "artifactName": "NDI-Multisite-Setup-${version}.${ext}"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ],
    "icon": "assets/icon.png",
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "artifactName": "NDI-Multisite-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "include": "installer.nsh"
  },
  "asarUnpack": [
    "dist/main/ndi/receiverWorker.js",
    "node_modules/@stagetimerio/grandiose/**/*"
  ],
  "npmRebuild": true,
  "buildDependenciesFromSource": false,
  "publish": {
    "provider": "github",
    "owner": "rule4400",
    "repo": "ndi-multisite"
  }
}
